# ---------------------------------------------------------------------------
# Terraform state — NEVER commit. State files contain resource attributes and
# can contain plaintext secrets (RDS passwords, generated keys, tokens).
# ---------------------------------------------------------------------------
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl.bak
crash.log
crash.*.log

# The dependency lock file belongs to the ROOT module (bootstrap, environments/*),
# where it pins provider checksums across every platform CI runs on. Reusable
# child modules under modules/ don't select providers, so a lock committed there
# is noise — and a single-platform one breaks init on a different OS.
modules/*/.terraform.lock.hcl

# ---------------------------------------------------------------------------
# Variable files — may contain account IDs, CIDRs, ARNs, credentials.
# Only *.tfvars.example is tracked.
# ---------------------------------------------------------------------------
*.tfvars
*.tfvars.json
!*.tfvars.example
!example.tfvars

# Plan output — a plan is a readable dump of your infrastructure
*.tfplan
*.tfplan.*
plan.out
plan.json

# Backend partial-config — the real file names the state bucket (which embeds
# the account ID). Only the .example is tracked.
backend.hcl
!backend.hcl.example

# ---------------------------------------------------------------------------
# Credentials and keys
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.ppk
*.key
!*.pub
credentials
.aws/
.envrc

# CI / tooling artefacts
.checkov.baseline
results_*.json
*.sarif

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
